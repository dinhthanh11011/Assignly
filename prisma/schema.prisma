// Prisma schema cho ứng dụng quản lý thu chi / cho vay / thu nợ.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js (NextAuth) models ────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  // App relations
  ownedGroups        Group[]            @relation("GroupOwner")
  memberships        GroupMember[]
  joinRequests       GroupJoinRequest[]
  transactions       Transaction[]      @relation("TransactionCreator")
  paidTransactions   Transaction[]      @relation("TransactionPayer")
  transactionSplits  TransactionSplit[]
  loans              Loan[]             @relation("LoanCreator")
  loanPayments       LoanPayment[]      @relation("LoanPaymentCreator")
  settlementsPaid    Settlement[]       @relation("SettlementPayer")
  settlementsGot     Settlement[]       @relation("SettlementPayee")
  settlementsCreated Settlement[]       @relation("SettlementCreator")
  pushSubscriptions  PushSubscription[]
  notifications      Notification[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Sổ thu chi (chia sẻ theo nhóm) ───────────────────────────────────────────
enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Một "sổ" thu chi. Nhiều người có thể cùng ghi chép trên một sổ
/// (sổ gia đình, sổ nhóm, sổ cá nhân…).
model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  members      GroupMember[]
  invites      GroupInvite[]
  joinRequests GroupJoinRequest[]
  categories   Category[]
  transactions Transaction[]
  loans        Loan[]
  settlements  Settlement[]
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model GroupJoinRequest {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  code      String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// ─── Thu chi ──────────────────────────────────────────────────────────────────
enum TxType {
  INCOME // khoản thu
  EXPENSE // khoản chi
}

/// Danh mục thu/chi của một sổ. Mỗi sổ mới được tạo kèm bộ danh mục mặc định.
model Category {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  type      TxType
  icon      String? // emoji hiển thị
  createdAt DateTime @default(now())

  group        Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions TransactionCategory[]

  @@unique([groupId, type, name])
  @@index([groupId])
}

/// Một giao dịch thu hoặc chi. `amount` luôn dương (VND); dấu nằm ở `type`.
model Transaction {
  id          String   @id @default(cuid())
  groupId     String
  type        TxType
  amount      Float
  date        DateTime @db.Date
  note        String?
  /// Người thực sự bỏ tiền ra (EXPENSE) hoặc nhận tiền về (INCOME) — có thể khác
  /// người ghi sổ. null ở dữ liệu cũ, khi đó coi như chính người ghi (`createdById`).
  paidById    String?
  createdById String
  /// Mã do MÁY CỦA NGƯỜI DÙNG sinh ra, chỉ có ở khoản đi qua hàng chờ ngoại tuyến
  /// (xem `src/lib/offline-queue.ts`). Request có thể ghi xong ở server rồi mới
  /// đứt kết nối trên đường về — client tưởng thất bại và gửi lại, thành ghi hai
  /// lần. Unique ở đây là chốt cuối chặn chuyện đó: `createTransaction` thấy mã
  /// đã tồn tại thì trả về khoản cũ chứ không tạo thêm. null ở mọi khoản ghi
  /// bình thường (khi đang có mạng) và ở toàn bộ dữ liệu cũ.
  clientId    String?  @unique
  createdAt   DateTime @default(now())

  group      Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation("TransactionCreator", fields: [createdById], references: [id])
  paidBy     User?                 @relation("TransactionPayer", fields: [paidById], references: [id])
  splits     TransactionSplit[]
  categories TransactionCategory[]

  @@index([groupId, date])
}

/// Một giao dịch có thể thuộc nhiều danh mục (VD: đi siêu thị = Ăn uống + Nhà cửa).
/// `position` giữ đúng thứ tự người dùng chọn; danh mục đầu tiên là danh mục
/// chính — icon và tên của nó đại diện cho giao dịch trong danh sách.
model TransactionCategory {
  transactionId String
  categoryId    String
  position      Int    @default(0)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([transactionId, categoryId])
  @@index([categoryId])
}

/// Phần một thành viên phải chịu trong một giao dịch.
///
/// Hai cách chia, có thể trộn trong cùng một giao dịch:
/// - `amount` != null → số tiền cố định của người này.
/// - `amount` == null → chia phần còn lại theo `weight` (chia đều = mọi người weight 1).
///
/// Giao dịch không có dòng split nào (dữ liệu cũ) được coi như chia đều cho toàn
/// bộ thành viên hiện tại của sổ.
model TransactionSplit {
  id            String @id @default(cuid())
  transactionId String
  userId        String
  weight        Float  @default(1)
  amount        Float?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transactionId, userId])
  @@index([transactionId])
}

/// Một lần chuyển tiền giữa hai thành viên để cân bằng chênh lệch chi tiêu.
/// Không phải giao dịch thu/chi của sổ — chỉ dịch chuyển tiền trong nội bộ nhóm.
model Settlement {
  id          String   @id @default(cuid())
  groupId     String
  fromUserId  String // người trả
  toUserId    String // người nhận
  amount      Float
  date        DateTime @db.Date
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from      User  @relation("SettlementPayer", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User  @relation("SettlementPayee", fields: [toUserId], references: [id], onDelete: Cascade)
  createdBy User  @relation("SettlementCreator", fields: [createdById], references: [id])

  @@index([groupId, date])
}

// ─── Cho vay / đi vay ─────────────────────────────────────────────────────────
enum LoanType {
  LEND // mình cho người khác vay → cần thu nợ
  BORROW // mình đi vay → cần trả nợ
}

enum LoanStatus {
  ACTIVE // đang còn nợ
  PAID // đã tất toán
  CANCELLED // huỷ / xoá nợ
}

model Loan {
  id           String     @id @default(cuid())
  groupId      String
  type         LoanType
  counterparty String // tên người vay / người cho vay
  amount       Float // số tiền gốc
  date         DateTime   @db.Date // ngày phát sinh
  dueDate      DateTime?  @db.Date // hạn trả
  interestRate Float? // lãi suất %/tháng, null = không lãi
  note         String?
  status       LoanStatus @default(ACTIVE)
  createdById  String
  createdAt    DateTime   @default(now())

  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User          @relation("LoanCreator", fields: [createdById], references: [id])
  payments  LoanPayment[]

  @@index([groupId, status])
  @@index([dueDate])
}

/// Một lần thu nợ (với LEND) hoặc trả nợ (với BORROW).
model LoanPayment {
  id          String   @id @default(cuid())
  loanId      String
  amount      Float
  date        DateTime @db.Date
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  loan      Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdBy User @relation("LoanPaymentCreator", fields: [createdById], references: [id])

  @@index([loanId])
}

// ─── Thông báo ────────────────────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
