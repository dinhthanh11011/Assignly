// Prisma schema cho ứng dụng quản lý thu chi / cho vay / thu nợ.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js (NextAuth) models ────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]

  // App relations
  ownedGroups        Group[]            @relation("GroupOwner")
  memberships        GroupMember[]
  joinRequests       GroupJoinRequest[]
  transactions       Transaction[]      @relation("TransactionCreator")
  loans              Loan[]             @relation("LoanCreator")
  loanPayments       LoanPayment[]      @relation("LoanPaymentCreator")
  pushSubscriptions  PushSubscription[]
  notifications      Notification[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Sổ thu chi (chia sẻ theo nhóm) ───────────────────────────────────────────
enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Một "sổ" thu chi. Nhiều người có thể cùng ghi chép trên một sổ
/// (sổ gia đình, sổ nhóm, sổ cá nhân…).
model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  members      GroupMember[]
  invites      GroupInvite[]
  joinRequests GroupJoinRequest[]
  categories   Category[]
  transactions Transaction[]
  loans        Loan[]
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model GroupJoinRequest {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  code      String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// ─── Thu chi ──────────────────────────────────────────────────────────────────
enum TxType {
  INCOME // khoản thu
  EXPENSE // khoản chi
}

/// Danh mục thu/chi của một sổ. Mỗi sổ mới được tạo kèm bộ danh mục mặc định.
model Category {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  type      TxType
  icon      String? // emoji hiển thị
  createdAt DateTime @default(now())

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([groupId, type, name])
  @@index([groupId])
}

/// Một giao dịch thu hoặc chi. `amount` luôn dương (VND); dấu nằm ở `type`.
model Transaction {
  id          String   @id @default(cuid())
  groupId     String
  categoryId  String?
  type        TxType
  amount      Float
  date        DateTime @db.Date
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TransactionCreator", fields: [createdById], references: [id])

  @@index([groupId, date])
  @@index([categoryId])
}

// ─── Cho vay / đi vay ─────────────────────────────────────────────────────────
enum LoanType {
  LEND // mình cho người khác vay → cần thu nợ
  BORROW // mình đi vay → cần trả nợ
}

enum LoanStatus {
  ACTIVE // đang còn nợ
  PAID // đã tất toán
  CANCELLED // huỷ / xoá nợ
}

model Loan {
  id           String     @id @default(cuid())
  groupId      String
  type         LoanType
  counterparty String // tên người vay / người cho vay
  amount       Float // số tiền gốc
  date         DateTime   @db.Date // ngày phát sinh
  dueDate      DateTime?  @db.Date // hạn trả
  interestRate Float? // lãi suất %/tháng, null = không lãi
  note         String?
  status       LoanStatus @default(ACTIVE)
  createdById  String
  createdAt    DateTime   @default(now())

  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User          @relation("LoanCreator", fields: [createdById], references: [id])
  payments  LoanPayment[]

  @@index([groupId, status])
  @@index([dueDate])
}

/// Một lần thu nợ (với LEND) hoặc trả nợ (với BORROW).
model LoanPayment {
  id          String   @id @default(cuid())
  loanId      String
  amount      Float
  date        DateTime @db.Date
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  loan      Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdBy User @relation("LoanPaymentCreator", fields: [createdById], references: [id])

  @@index([loanId])
}

// ─── Thông báo ────────────────────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
