// Prisma schema cho ứng dụng quản lý thu chi / cho vay / thu nợ.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js (NextAuth) models ────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  // App relations
  ownedGroups        Group[]            @relation("GroupOwner")
  memberships        GroupMember[]
  joinRequests       GroupJoinRequest[]
  transactions       Transaction[]      @relation("TransactionCreator")
  paidTransactions   Transaction[]      @relation("TransactionPayer")
  transactionSplits  TransactionSplit[]
  loans              Loan[]             @relation("LoanCreator")
  loanPayments       LoanPayment[]      @relation("LoanPaymentCreator")
  settlementsPaid    Settlement[]       @relation("SettlementPayer")
  settlementsGot     Settlement[]       @relation("SettlementPayee")
  settlementsCreated Settlement[]       @relation("SettlementCreator")
  pushSubscriptions  PushSubscription[]
  notifications      Notification[]

  /// Quản trị viên toàn hệ thống — khác hẳn `Role` bên trong từng sổ.
  /// Bật/tắt ở /admin. Danh sách `ADMIN_EMAILS` trong env LUÔN là admin kể cả khi
  /// cờ này false; đó là đường mở khoá khi trong DB không còn admin nào.
  isAdmin Boolean @default(false)

  /// Khoá tài khoản mà KHÔNG xoá dữ liệu. Đây là "xoá" trên thực tế.
  ///
  /// Xoá thật không làm được: `Transaction/Loan/LoanPayment/Settlement.createdById`
  /// đều `onDelete: Restrict` nên xoá sẽ ném lỗi khoá ngoại, trong khi
  /// `Group.ownerId` lại `Cascade` — nên một cú xoá vừa có thể fail giữa chừng,
  /// vừa kéo theo nguyên những sổ chung cùng dữ liệu của người khác. Thêm nữa
  /// `Transaction.paidById` là `SetNull`, mà null nghĩa là "người ghi đã trả",
  /// nên xoá user còn âm thầm ghi sai ai bỏ tiền ra trên khoản của người khác.
  disabledAt DateTime?

  /// Lần cuối người này MỞ app — khác với lần cuối họ có ghi chép.
  ///
  /// Phải có cột này thì mới đếm được DAU/WAU/MAU: phiên đăng nhập dùng JWT
  /// (`auth.config.ts`) nên bảng `Session` luôn rỗng, và nếu chỉ suy từ
  /// `createdAt` của các khoản ghi thì bỏ sót toàn bộ người chỉ mở lên xem báo cáo.
  /// Ghi có tiết chế ở `(app)/layout.tsx`. null = chưa mở lần nào KỂ TỪ KHI cột
  /// này ra đời, KHÔNG phải chưa bao giờ dùng app.
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  /// Biểu đồ người dùng mới theo ngày, và danh sách sắp theo ngày tham gia.
  @@index([createdAt])
  /// Ba con số DAU/WAU/MAU là ba lần đếm trên đúng cột này.
  @@index([lastSeenAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── KHÔNG DÙNG enum CỦA POSTGRES TRONG REPO NÀY ─────────────────────────────
//
// Mọi trường "một trong vài giá trị" ở đây là `String`, và giá trị hợp lệ được
// kiểm ở tầng server (xem `src/lib/enums.ts`, nơi giữ danh sách duy nhất). Đây
// là LUẬT CỦA REPO, không phải sở thích: xem mục "Không bao giờ dùng enum dưới
// DB" trong AGENTS.md để biết lý do, và `scripts/check-migrations.sh` sẽ chặn
// nếu có ai thêm lại `enum` vào file này hoặc `CREATE TYPE ... AS ENUM` vào một
// migration mới.

// ─── Sổ thu chi (chia sẻ theo nhóm) ───────────────────────────────────────────

/// Một "sổ" thu chi. Nhiều người có thể cùng ghi chép trên một sổ
/// (sổ gia đình, sổ nhóm, sổ cá nhân…).
model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  /// Tăng 1 sau MỖI lần dữ liệu của sổ đổi (giao dịch, khoản vay, trả nợ, tất
  /// toán, loại, thành viên) — xem `bumpGroupRevision` ở `src/lib/ledger-revision.ts`.
  /// Màn hình đang mở hỏi số này định kỳ và chỉ tải lại khi nó lớn hơn số đã dựng
  /// trang (`LiveRefresh`). Một lần đọc theo khoá chính, thay cho việc cộng dồn
  /// cả bảng giao dịch ở mỗi nhịp hỏi.
  revision  Int      @default(0)

  members      GroupMember[]
  invites      GroupInvite[]
  joinRequests GroupJoinRequest[]
  categories   Category[]
  transactions Transaction[]
  loans        Loan[]
  settlements  Settlement[]
}

model GroupJoinRequest {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  /// "PENDING" | "APPROVED" | "REJECTED" — xem `JOIN_REQUEST_STATUSES`.
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  /// "OWNER" | "ADMIN" | "MEMBER" — xem `GROUP_ROLES` trong src/lib/enums.ts.
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  code      String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// ─── Thu chi ──────────────────────────────────────────────────────────────────

/// Danh mục thu/chi của một sổ. Mỗi sổ mới được tạo kèm bộ danh mục mặc định.
model Category {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  /// "INCOME" (khoản thu) | "EXPENSE" (khoản chi) — xem `TX_TYPES`.
  type      String
  icon      String? // emoji hiển thị
  createdAt DateTime @default(now())

  group        Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions TransactionCategory[]

  @@unique([groupId, type, name])
  @@index([groupId])
}

/// Một giao dịch thu hoặc chi. `amount` luôn dương (VND); dấu nằm ở `type`.
model Transaction {
  id            String   @id @default(cuid())
  groupId       String
  /// "INCOME" (khoản thu) | "EXPENSE" (khoản chi) — xem `TX_TYPES`.
  type          String
  amount        Float
  /// true = khoản GHI TRƯỚC KHI BIẾT SỐ TIỀN (đi ăn người khác trả hộ, hoá đơn
  /// chưa chốt…). Ghi ngay để không quên, số tiền điền sau khi biết.
  ///
  /// Lúc đó `amount` = 0 chứ không phải null: mọi phép tổng (`_sum`), mọi biểu đồ
  /// và toàn bộ phần cân đối tiền chung cộng cột này thẳng vào kết quả, nên null
  /// sẽ phải sửa đúng và đủ ở hơn mười chỗ — bỏ sót một chỗ là sổ nói sai số tiền.
  /// Với 0 thì khoản chưa rõ KHÔNG đóng góp gì vào mọi con số, và đó chính là điều
  /// đúng cần làm: chưa biết thì chưa được phép làm lệch tổng của sổ.
  ///
  /// Cờ này là thứ duy nhất phân biệt "chưa biết" với "đúng 0 đồng", nên chỗ nào
  /// hiện số tiền cũng phải đọc nó — xem `transactionAmountText` trong lib/copy.ts.
  amountUnknown Boolean  @default(false)
  date          DateTime @db.Date
  note          String?
  /// Người thực sự bỏ tiền ra (EXPENSE) hoặc nhận tiền về (INCOME) — có thể khác
  /// người ghi sổ. null ở dữ liệu cũ, khi đó coi như chính người ghi (`createdById`).
  paidById      String?
  createdById   String
  /// Mã do MÁY CỦA NGƯỜI DÙNG sinh ra, chỉ có ở khoản đi qua hàng chờ ngoại tuyến
  /// (xem `src/lib/offline-queue.ts`). Request có thể ghi xong ở server rồi mới
  /// đứt kết nối trên đường về — client tưởng thất bại và gửi lại, thành ghi hai
  /// lần. Unique ở đây là chốt cuối chặn chuyện đó: `createTransaction` thấy mã
  /// đã tồn tại thì trả về khoản cũ chứ không tạo thêm. null ở mọi khoản ghi
  /// bình thường (khi đang có mạng) và ở toàn bộ dữ liệu cũ.
  clientId      String?  @unique
  /// KIỂU CHIA người dùng đã chọn ở form — và nó tồn tại vì không suy ngược lại
  /// được từ các dòng `TransactionSplit`.
  ///
  /// Các dòng split chỉ mang `weight`/`amount`, nên "chia đều cho 2 người" và
  /// "theo phần: mỗi người 1 phần" ghi xuống DB thành DỮ LIỆU GIỐNG HỆT NHAU, và
  /// "theo phần: Thành 1, Huế 0" thì lưu đúng một dòng weight 1 — không phân biệt
  /// nổi với chia đều cho một mình Thành. Màn hình sửa vì thế mở lên với ô "Chia
  /// đều" sáng lên thay cho kiểu vừa lưu. Số tiền thì vẫn đúng (hai kiểu tính ra
  /// cùng một kết quả), nhưng app đang nói sai lựa chọn của người dùng.
  ///
  /// null ở toàn bộ dữ liệu cũ — khi đó form đoán lại từ các dòng split như
  /// trước (xem `splitStateFrom`).
  /// "EQUAL" (chia đều) | "WEIGHT" (theo phần) | "EXACT" (tự nhập từng người)
  /// — xem `SPLIT_MODES`.
  splitMode     String?
  /// Tăng 1 mỗi lần khoản này được ghi lại. ĐÂY LÀ CHỐT CHẶN GHI ĐÈ trong sổ chung:
  /// hai người có thể cùng mở một khoản để sửa, và màn hình sửa gửi lên kèm số
  /// version nó đã đọc. Server chỉ ghi nếu số đó còn đúng — nếu không thì bản trên
  /// DB đã là của người khác, và ghi tiếp là xoá sạch sửa của họ mà không ai hay.
  /// Xem `updateTransaction` / `deleteTransaction` trong src/lib/actions.ts.
  ///
  /// Không dùng `createdAt`/`updatedAt` thay cho cột này: hai lần ghi trong cùng
  /// một mili-giây mang cùng một mốc thời gian, tức là đúng trường hợp cần phân
  /// biệt nhất thì nó lại không phân biệt được.
  version       Int      @default(0)
  createdAt     DateTime @default(now())

  group      Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation("TransactionCreator", fields: [createdById], references: [id])
  paidBy     User?                 @relation("TransactionPayer", fields: [paidById], references: [id])
  splits     TransactionSplit[]
  categories TransactionCategory[]

  @@index([groupId, date])
  /// Danh sách "khoản chưa rõ số tiền" chạy ở MỌI lần mở trang chủ, và nó hỏi
  /// đúng một câu: sổ này còn khoản nào chưa điền tiền? Không có index thì câu đó
  /// phải quét toàn bộ giao dịch của sổ để tìm vài dòng.
  @@index([groupId, amountUnknown])
  /// Bảng lớn nhất, và MỌI truy vấn thống kê của trang quản trị đều lọc trên hai
  /// cột này ("ai đã ghi gì trong 30 ngày qua"). Không có index thì mỗi lần mở
  /// /admin là một lần quét toàn bộ giao dịch của cả app.
  @@index([createdById, createdAt])
}

/// Một giao dịch có thể thuộc nhiều danh mục (VD: đi siêu thị = Ăn uống + Nhà cửa).
/// `position` giữ đúng thứ tự người dùng chọn; danh mục đầu tiên là danh mục
/// chính — icon và tên của nó đại diện cho giao dịch trong danh sách.
model TransactionCategory {
  transactionId String
  categoryId    String
  position      Int    @default(0)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([transactionId, categoryId])
  @@index([categoryId])
}

/// Phần một thành viên phải chịu trong một giao dịch.
///
/// Hai cách chia, có thể trộn trong cùng một giao dịch:
/// - `amount` != null → số tiền cố định của người này.
/// - `amount` == null → chia phần còn lại theo `weight` (chia đều = mọi người weight 1).
///
/// Giao dịch không có dòng split nào (dữ liệu cũ) được coi như chia đều cho toàn
/// bộ thành viên hiện tại của sổ.
model TransactionSplit {
  id            String @id @default(cuid())
  transactionId String
  userId        String
  weight        Float  @default(1)
  amount        Float?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transactionId, userId])
  @@index([transactionId])
}

/// Một lần chuyển tiền giữa hai thành viên để cân bằng chênh lệch chi tiêu.
/// Không phải giao dịch thu/chi của sổ — chỉ dịch chuyển tiền trong nội bộ nhóm.
model Settlement {
  id          String   @id @default(cuid())
  groupId     String
  fromUserId  String // người trả
  toUserId    String // người nhận
  amount      Float
  date        DateTime @db.Date
  note        String?
  createdById String
  /// Tăng 1 mỗi lần lần đưa tiền này được ghi lại — chốt chặn ghi đè trong sổ chung,
  /// y như `Transaction.version`: màn hình sửa/xoá gửi kèm số nó đã đọc.
  version     Int      @default(0)
  createdAt   DateTime @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from      User  @relation("SettlementPayer", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User  @relation("SettlementPayee", fields: [toUserId], references: [id], onDelete: Cascade)
  createdBy User  @relation("SettlementCreator", fields: [createdById], references: [id])

  @@index([groupId, date])
}

// ─── Cho vay / đi vay ─────────────────────────────────────────────────────────

model Loan {
  id           String    @id @default(cuid())
  groupId      String
  /// "LEND" (mình cho vay, cần thu nợ) | "BORROW" (mình đi vay) — xem `LOAN_TYPES`.
  type         String
  counterparty String // tên người vay / người cho vay
  amount       Float // số tiền gốc
  date         DateTime  @db.Date // ngày phát sinh
  dueDate      DateTime? @db.Date // hạn trả
  interestRate Float? // lãi suất %/tháng, null = không lãi
  note         String?
  /// "ACTIVE" (đang còn nợ) | "PAID" (đã tất toán) | "CANCELLED" (huỷ/xoá nợ)
  /// — xem `LOAN_STATUSES`.
  status       String    @default("ACTIVE")
  createdById  String
  /// Tăng 1 mỗi lần khoản mượn này được ghi lại — chốt chặn ghi đè trong sổ chung,
  /// y như `Transaction.version`: màn hình sửa/xoá gửi kèm số nó đã đọc.
  version      Int       @default(0)
  createdAt    DateTime  @default(now())

  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User          @relation("LoanCreator", fields: [createdById], references: [id])
  payments  LoanPayment[]

  @@index([groupId, status])
  @@index([dueDate])
}

/// Một lần thu nợ (với LEND) hoặc trả nợ (với BORROW).
model LoanPayment {
  id          String   @id @default(cuid())
  loanId      String
  amount      Float
  date        DateTime @db.Date
  note        String?
  createdById String
  /// Tăng 1 mỗi lần lần thu/trả này được ghi lại — chốt chặn ghi đè trong sổ chung,
  /// y như `Transaction.version`: màn hình sửa/xoá gửi kèm số nó đã đọc.
  version     Int      @default(0)
  createdAt   DateTime @default(now())

  loan      Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdBy User @relation("LoanPaymentCreator", fields: [createdById], references: [id])

  @@index([loanId])
}

// ─── Thông báo ────────────────────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  /// Danh sách thông báo phân trang theo `createdAt` giảm dần của một người.
  @@index([userId, createdAt])
}
