# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reminder?schema=public"

# Auth.js — generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# Required for `next start` / self-hosting: trust the Host header (Auth.js only
# auto-trusts it in dev, otherwise every /api/auth/* call throws UntrustedHost).
AUTH_TRUST_HOST=true
# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
